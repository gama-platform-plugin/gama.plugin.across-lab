Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: PMML Evaluation skill based on JPMML
Bundle-SymbolicName: gama.extension.pmml;singleton:=true
Bundle-Version: 1.0.0.qualifier
Export-Package: gama.extension.pmml.skills
Require-Bundle: gama.core;bundle-version="0.0.0",
 gama.dependencies;bundle-version="0.0.0",gama.annotations,
 gama.processor,gama.api
Automatic-Module-Name: gama.extension.pmml
Bundle-ClassPath: .,
 lib/pmml-evaluator-1.7.7.jar,
 lib/pmml-evaluator-metro-1.7.7.jar,
 lib/pmml-model-1.7.7.jar
Bundle-RequiredExecutionEnvironment: JavaSE-25
